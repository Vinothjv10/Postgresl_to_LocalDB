# ──────────────────────────────────────────
#  Environment-specific config
#  Place this file at: env/<env>/.env
#  Available: dev, staging, prod
#
#  Usage: python main.py --env <env>
# ──────────────────────────────────────────

# Source PostgreSQL (remote — READ ONLY)
SOURCE_DB_HOST=your-source-host
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=source_db
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres

# Target PostgreSQL (local — receives data)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=local_db
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=postgres

# Batch settings
BATCH_SIZE=10000
RECORD_LIMIT=100000
